# SynthVerify configuration (all optional; defaults shown in synthverify/config.py)

# --- app
SV_ENVIRONMENT=production
SV_LOG_LEVEL=INFO

# --- data
SV_DATABASE_URL=sqlite:///data/synthverify.db
# SV_DATABASE_URL=postgresql+psycopg://sv:secret@postgres:5432/synthverify
#   (the CI migrations job uses the BSD pg8000 driver test-side only:
#    postgresql+pg8000://... - production stays on psycopg)
SV_ARTIFACTS_DIR=data/artifacts
SV_MAX_UPLOAD_BYTES=67108864
SV_MAX_INLINE_BYTES=8388608

# --- media storage (REQ-INFRA-4): one seam, chosen by configuration alone
SV_MEDIA_STORE=local
SV_STORAGE_DIR=data/media
# Any S3-compatible endpoint - MinIO, SeaweedFS, Ceph, R2, AWS.
# Requires an external fetch/mirror step for rows written while SV_MEDIA_STORE=local.
# SV_MEDIA_STORE=s3
# SV_S3_ENDPOINT=http://minio:9000
# SV_S3_BUCKET=synthverify-evidence
# SV_S3_REGION=us-east-1
# SV_S3_ACCESS_KEY=
# SV_S3_SECRET_KEY=
# SV_S3_PATH_STYLE=true
# SV_S3_PREFIX=media

# --- pipeline
SV_EMBEDDED_WORKER=true
SV_WORKER_COUNT=4
SV_QUEUE_MAX_SIZE=512
# SV_JOB_BROKER=embedded        # or "postgres": the jobs table becomes the queue (FOR UPDATE SKIP
#   LOCKED + a lease), so N API replicas and N `synthverify worker` containers share one queue with
#   no Redis. Requires SV_DATABASE_URL on Postgres and a schema at revision 0003 or later (`make
#   migrate`; head is 0007, which adds the retention policy, legal-hold and audit-checkpoint tables).
#   Worker-less replicas ("no embedded worker") are how AC-INFRA-2 is deployed: see
#   docker/compose-scale.yml.
# SV_BROKER_POLL_SECONDS=0.5    # how often a worker asks the queue for work
# SV_WORKER_LEASE_SECONDS=600   # a running job unclaimed for this long is re-queueable

# --- auth: bring your own first admin key (use a long random secret!)
# python -c "import secrets; print('sv_live_' + secrets.token_hex(16))"
SV_BOOTSTRAP_ADMIN_KEY=

# --- rate limiting
SV_RATE_LIMIT_RPM=120
SV_RATE_LIMIT_BURST=40
# REQ-INFRA-3: where the budget is kept. "in-process" (default) is a token bucket per replica, so
# n replicas admit n times the budget; "valkey" keeps one bucket per subject inside a Valkey server
# so every replica shares it. Valkey (BSD-3) is the supported server - not Redis >= 7.4, whose
# RSALv2/SSPL licence FC-1 forbids. Needs the optional extra: pip install "synthverify[valkey]".
# If the server is unreachable the limiter falls back to the in-process bucket and /readyz reports
# rate_limit_degraded=true; it never 500s and never hangs past SV_RATE_LIMIT_TIMEOUT_SECONDS.
SV_RATE_LIMIT_BACKEND=in-process
SV_RATE_LIMIT_VALKEY_HOST=127.0.0.1
SV_RATE_LIMIT_VALKEY_PORT=6379
SV_RATE_LIMIT_TIMEOUT_SECONDS=0.5
SV_RATE_LIMIT_FALLBACK_COOLDOWN_SECONDS=5

# --- routing policy defaults
SV_BLOCK_SCORE=0.85
SV_MANUAL_REVIEW_SCORE=0.50

# --- retention / TTL deletion (REQ-INFRA-5)
# The TTL itself is data, not config: one row per organisation in `retention_policies`, written with
# `PUT /api/v1/admin/retention/policies/{org}` or read back from `GET` the same path. No row means
# "keep that organisation's media forever", which is why the default below is commented out - an
# install that sets nothing loses nothing.
# SV_RETENTION_DEFAULT_DAYS=90  # the fallback for organisations with no row of their own (>= 1)
# SV_RETENTION_SWEEP_ENABLED=true   # the sweep runs on the WorkerFleet, so a worker-less API replica
#   (the AC-INFRA-2 shape) does NOT sweep - exactly one replica or worker needs this on.
# SV_RETENTION_SWEEP_INTERVAL_SECONDS=3600  # sleeps *before* its first pass, so restarting a fleet
#   cannot purge a tenant's evidence the moment it comes back up. The scheduler treats it as a floor,
#   not a promise: passes never start less than a second apart, so a mistyped 0 cannot spin the loop.
# SV_RETENTION_BATCH_LIMIT=500    # assets one transaction may hold; the next pass takes the rest.
# A legal hold (`POST /api/v1/admin/retention/holds`) blocks deletion for a sha256 or a job id and is
# recorded in the audit ledger when it is created. To run a pass by hand, preview first:
#   python -m synthverify.cli retention-sweep            # plan only, deletes nothing
#   python -m synthverify.cli retention-sweep --apply     # the opt-in that actually removes bytes

# --- audit ledger checkpoints (REQ-IDAM-4)
# Every N appended events the chain is *sealed*: one `audit_checkpoints` row naming the range it
# closes and the head hash that range reaches, written inside the same transaction as the events. The
# verifier still hashes every row - a seal is a fixed point to compare against, not a licence to skip
# work - so this only decides how far back tampering can be *located*, and how many rows at the tail a
# writer could delete without leaving anything behind to contradict it. 0 turns sealing off, which is
# what a pre-`0007` install had.
#   python -m synthverify.cli audit-checkpoint --backfill   # seal an existing ledger, verifying first
#   python -m synthverify.cli audit-verify                  # rows hashed, seals cross-checked, head hash
# SV_AUDIT_CHECKPOINT_EVERY=5000

# --- webhooks
SV_WEBHOOK_TIMEOUT_SECONDS=8
SV_WEBHOOK_MAX_ATTEMPTS=5
SV_WEBHOOK_BACKOFF_BASE_SECONDS=2
